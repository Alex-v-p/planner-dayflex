# Local-only Compose defaults. Replace values through your shell or a copied
# untracked .env file when needed; do not commit real secrets.

PLANNER_EDGE_PORT=8080

POSTGRES_USER=planner_dayflex
POSTGRES_PASSWORD=planner_dayflex_local
POSTGRES_DB=planner_dayflex

PLANNER_API_ENVIRONMENT=development
PLANNER_API_DATABASE_URL=postgresql+psycopg://planner_dayflex:planner_dayflex_local@postgres:5432/planner_dayflex
PLANNER_API_LOG_LEVEL=INFO
PLANNER_API_SCHEDULER_VERSION=0.1.0
PLANNER_API_AI_SERVICE_BASE_URL=http://ai:8002
PLANNER_API_AI_CLIENT_TIMEOUT_SECONDS=2.0
PLANNER_API_WORKER_REDIS_URL=redis://redis:6379/0

PLANNER_AI_PROVIDER_ENABLED=false
PLANNER_AI_PROVIDER=disabled
PLANNER_AI_MODEL=mock-parser-v1
PLANNER_AI_PROVIDER_BASE_URL=http://ollama:11434
PLANNER_AI_PROVIDER_TIMEOUT_SECONDS=2.0
PLANNER_AI_LOG_LEVEL=INFO

PLANNER_WORKER_REDIS_URL=redis://redis:6379/0
PLANNER_WORKER_AI_SERVICE_BASE_URL=http://ai:8002
PLANNER_WORKER_LOG_LEVEL=INFO
PLANNER_WORKER_QUEUE_NAME=planner-dayflex-worker
